home.sharpmaind.ru {
	handle /xh* {
		reverse_proxy http://127.0.0.1:10445 {
			flush_interval -1
			transport http {
				versions 1.1
			}
			header_up Host vpn2.sharpmaind.ru
			header_up X-Forwarded-Proto https
		}
	}


	handle /vpngrpc* {
		reverse_proxy h2c://127.0.0.1:10444 {
			header_up Host vpn2.sharpmaind.ru
			header_up X-Forwarded-Proto https
		}
	}

	header -Alt-Svc
	header -alt-svc
	bind 185.141.217.43
	tls internal
	handle /api/* {
		reverse_proxy http://127.0.0.1:3000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /vpn* {
		reverse_proxy http://127.0.0.1:10443 {
			flush_interval -1
			transport http {
				versions 1.1
			}
			header_up Host vpn2.sharpmaind.ru
			header_up X-Forwarded-Proto https
		}
	}
}
